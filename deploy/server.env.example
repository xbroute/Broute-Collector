# Copy to .env locally. Never commit the resulting file.
POSTGRES_PASSWORD=replace-with-a-random-database-admin-password
BROUTE_DB_PASSWORD=replace-with-a-different-random-runtime-password
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROUTE_STATE_KEY=replace-with-generated-fernet-key
BROUTE_INSTANCE=broute
TELEGRAM_BOT_TOKEN=replace-with-existing-token
TELEGRAM_OWNER_USER_IDS=replace-with-your-numeric-user-id
# Preserve the ORIGINAL encryption keys when importing existing state.
# Leave empty if the existing state derives its encryption from the same bot token.
TELEGRAM_SOURCE_ENCRYPTION_KEY=
TELEGRAM_DESTINATION_ENCRYPTION_KEY=
BROUTE_COLLECTION_INTERVAL=300
MAX_VALIDATIONS_PER_RUN=500
# Set to the final public HTTPS URL during deployment.
TELEGRAM_ONLINE_SUBSCRIPTION_URL=https://xbroute.github.io/Broute-Collector/data/online-sub.txt
